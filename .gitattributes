*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.c text eol=lf
*.txt text eol=lf
*.adf binary
# Durable compiler controls retain their hash-bound original byte representation.
evidence/rules/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
evidence/blockers/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
tests/fixtures/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
.ignore text eol=lf
*.ps1 text eol=lf
# Preserve exact historical compile inputs, including hashed terminal newlines.
recovery/units/**/unit.c whitespace=-blank-at-eof
# Retained model hypotheses are hash-bound evidence, including rejected C.
recovery/candidates/**/*.c whitespace=-blank-at-eol,-blank-at-eof
